# Copy this file to .env for local development. Never commit .env.
# In production, set these in Vercel: Project > Settings > Environment Variables.

# GitHub repository whose Releases feed the changelog section.
GITHUB_OWNER=
GITHUB_REPO=

# Optional. Needed only for private repositories or a higher API rate limit.
# Server-side only: read by lib/github, never sent to the browser.
# Use a fine-grained token with read-only "Contents" access to this one repo.
GITHUB_TOKEN=
